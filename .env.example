# -----------------------------------------------------------------------------
# Furniro E-Commerce Template - Environment Configuration
# -----------------------------------------------------------------------------

# Application base URL (used for metadata, OpenGraph, sitemap, callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Gemini API Key (if extending with AI assistant or product recommendations)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Stripe / Payment Gateway Keys (when connecting live payments)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
